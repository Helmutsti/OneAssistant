# Copia questo file in `.env`. La chiave resta nel processo Node e non viene esposta
# al frontend.

# Chiave del prototipo. OpenRouter e' l'unico provider attivo in questa fase.
OPENROUTER_API_KEY=

# Identificativo completo del modello OpenRouter. Il modello deve supportare i tool.
OPENROUTER_MODEL=anthropic/claude-opus-5
